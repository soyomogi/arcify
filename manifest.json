{
  "manifest_version": 3,
  "name": "Arcify: Arc like vertical tab spaces",
  "version": "5.1.0",
  "description": "A sidebar extension that replicates Arc browser's tab management system",
  "permissions": [
    "tabs",
    "tabGroups",
    "sidePanel",
    "storage",
    "bookmarks",
    "alarms",
    "commands",
    "favicon",
    "scripting",
    "clipboardWrite",
    "offscreen"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {},
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sidebar.js",
        "onboarding.js",
        "installation-onboarding.js",
        "assets/*",
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "icons": {
    "128": "assets/icon.png"
  },
  "commands": {
    "_execute_action": {
      "description": "Toggle side panel"
    },
    "quickPinToggle": {
      "description": "Quick Pin/Unpin Tab"
    },
    "selectSpace1": {
      "suggested_key": { "default": "Ctrl+Q", "mac": "MacCtrl+Q" },
      "description": "Select the first space"
    },
    "selectSpace2": {
      "suggested_key": { "default": "Ctrl+W", "mac": "MacCtrl+W" },
      "description": "Select the second space"
    },
    "selectSpace3": {
      "suggested_key": { "default": "Ctrl+E", "mac": "MacCtrl+E" },
      "description": "Select the third space"
    },
    "selectSpace4": {
      "suggested_key": { "default": "Ctrl+R", "mac": "MacCtrl+R" },
      "description": "Select the fourth space"
    },
    "nextSpace": {
      "description": "Navigate to the next space"
    },
    "previousSpace": {
      "description": "Navigate to the previous space"
    },
    "NextTabInSpace": {
      "description": "Navigates to next tab in space"
    },
    "PrevTabInSpace": {
      "description": "Navigates to prev tab in space"
    },
    "copyCurrentUrl": {
      "description": "Copy current tab URL"
    }
  },
  "options_page": "options.html"
}
